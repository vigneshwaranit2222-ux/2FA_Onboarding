# Copy to .env and replace every placeholder. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/resume_onboarding
# Optional; used by PostgreSQL integration tests after reviewed migrations are applied.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/resume_onboarding_test

# JWT signing and session lifetime
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Protection & Lifecycle
OTP_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# SMTP Email Delivery (STARTTLS on port 587 or SSL on port 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# WhatsApp Provider Configuration
# Set to 'meta' for Meta Cloud API or 'mock' for local tests
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT=10

# TOTP Authenticator (Handled in Day 4)
TOTP_ENCRYPTION_KEY=replace-with-a-Fernet-generated-key
TOTP_ISSUER=Resume Onboarding
